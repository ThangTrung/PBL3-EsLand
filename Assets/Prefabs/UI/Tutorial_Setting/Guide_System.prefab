  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "[M\u1EE4C TI\xCAU CH\xCDNH]\r\nCh\xE0o m\u1EEBng \u0111\u1EBFn v\u1EDBi
    EsLand! Nhi\u1EC7m v\u1EE5 c\u1EE7a b\u1EA1n l\xE0 thu th\u1EADp t\xE0i nguy\xEAn,
    ch\u1EBF t\u1EA1o trang b\u1ECB m\u1EA1nh m\u1EBD \u0111\u1EC3 \u0111\u1ED1i
    \u0111\u1EA7u v\u1EDBi l\u0169 qu\xE1i v\u1EADt v\xE0 t\xECm c\xE1ch tho\xE1t
    kh\u1ECFi h\xF2n \u0111\u1EA3o n\xE0y.\r\n\r\n[C\u01A0 CH\u1EBE SINH T\u1ED2N]\r 
    \n* M\xE1u (HP): N\u1EBFu m\xE1u v\u1EC1 0, b\u1EA1n s\u1EBD th\u1EA5t b\u1EA1i.
    H\xE3y lu\xF4n mang theo th\u1EE9c \u0103n \u0111\xE3 ch\u1EBF bi\u1EBFn.\r\n*
    Chu k\u1EF3 Ng\xE0y/\u0110\xEAm: Ban \u0111\xEAm qu\xE1i v\u1EADt s\u1EBD hung
    h\xE3n h\u01A1n. H\xE3y t\xECm v\u1EC1 Nh\xE0 (Home) \u0111\u1EC3 ngh\u1EC9 ng\u01A1i.\r\n\n\r[H\u1EC6
    TH\u1ED0NG NGH\u1EC8 NG\u01A0I]\r\n* T\xECm \u0111\u1EBFn \u0110i\u1EC3m L\u01B0u
    (Save Point) t\u1EA1i nh\xE0 c\u1EE7a b\u1EA1n.\r\n* S\u1EED d\u1EE5ng h\xE0nh
    \u0111\u1ED9ng Ng\u1EE7 (Sleep) \u0111\u1EC3 h\u1ED3i ph\u1EE5c ho\xE0n to\xE0n
    tr\u1EA1ng th\xE1i v\xE0 l\u01B0u l\u1EA1i ti\u1EBFn tr\xECnh ch\u01A1i.\r\n*
    Th\u1EDDi gian s\u1EBD tr\xF4i nhanh \u0111\u1EBFn s\xE1ng h\xF4m sau.\r\r\n\n[\u0110I\u1EC0U
    KI\u1EC6N CHI\u1EBEN TH\u1EAENG]\r\nH\u1EA1 g\u1EE5c Boss, thu th\u1EADp \u0111\u1EE7
    nguy\xEAn li\u1EC7u v\xE0 c\xE1c \u0111\xE1 s\u1EE9c m\u1EA1nh \u0111\u1EC3 x\xE2y
    d\u1EF1ng thuy\u1EC1n tr\u1ED1n tho\xE1t."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
